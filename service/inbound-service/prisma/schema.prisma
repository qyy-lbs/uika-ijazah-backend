generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model akademik {
  id_akademik Int       @id @default(autoincrement())
  uuid        String?   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_prodi    Int?
  kode_matkul String?   @db.VarChar(20)
  nama_matkul String?   @db.VarChar(100)
  bobot_k     Int?
  bobot_t     Int?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
  prodi       prodi?    @relation(fields: [id_prodi], references: [id_prodi], onDelete: NoAction, onUpdate: NoAction)
  nilai       nilai[]
}

model batch_upload {
  id_batch_upload    Int           @id @default(autoincrement())
  uuid               String?       @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_template        Int?
  nomor_batch_upload String?       @db.VarChar(50)
  nama_file          String?       @db.VarChar(100)
  total_record       Int?
  record_berhasil    Int?
  record_gagal       Int?
  uploaded_by        Int?
  periode            periode_enum?
  tahun_lulus        Int?
  log_error          String?
  created_at         DateTime?     @default(now()) @db.Timestamp(6)
  template           template?     @relation(fields: [id_template], references: [id_template], onDelete: Cascade, onUpdate: NoAction)
  users              users?        @relation(fields: [uploaded_by], references: [id_user], onDelete: NoAction, onUpdate: NoAction)
  mahasiswa          mahasiswa[]
}

model blockchain {
  id_blockchain Int       @id @default(autoincrement())
  uuid          String?   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_dokumen    Int?      @unique
  hash_dokumen  String?
  index_block   Int?
  hash_block    String?
  previous_hash String?
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  dokumen       dokumen?  @relation(fields: [id_dokumen], references: [id_dokumen], onDelete: NoAction, onUpdate: NoAction)
}

model dokumen {
  id_dokumen     Int                @id @default(autoincrement())
  uuid           String?            @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_mahasiswa   Int?
  id_template    Int?
  jenis_dokumen  jenis_dokumen_enum
  nomor_dokumen  String?            @db.VarChar(50)
  tanggal_terbit DateTime?          @db.Date
  is_verified    Boolean?           @default(false)
  file_pdf       String?
  file_pdf_final String?
  kode_qr        String?
  url_akses      String?
  download_count Int?               @default(0)
  max_download   Int?               @default(1)
  created_at     DateTime?          @default(now()) @db.Timestamp(6)
  updated_at     DateTime?          @default(now()) @db.Timestamp(6)
  blockchain     blockchain?
  mahasiswa      mahasiswa?         @relation(fields: [id_mahasiswa], references: [id_mahasiswa], onDelete: Cascade, onUpdate: NoAction)
  template       template?          @relation(fields: [id_template], references: [id_template], onDelete: NoAction, onUpdate: NoAction)
}

model log_aktivitas {
  id_log     Int       @id @default(autoincrement())
  uuid       String?   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_user    Int?
  aktivitas  String?   @db.VarChar(50)
  deskripsi  String?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      users?    @relation(fields: [id_user], references: [id_user], onDelete: NoAction, onUpdate: NoAction)
}

model mahasiswa {
  id_mahasiswa      Int           @id @default(autoincrement())
  uuid              String?       @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_prodi          Int?
  id_batch_upload   Int?
  nim               String        @unique(map: "uq_mahasiswa_nim") @db.VarChar(50)
  nik               String?       @unique(map: "uq_mahasiswa_nik") @db.VarChar(50)
  nomor_seri_ijazah String?       @unique(map: "uq_mahasiswa_no_ijazah") @db.VarChar(50)
  pisn              String?       @unique(map: "uq_mahasiswa_pisn") @db.VarChar(50)
  nama_mahasiswa    String?       @db.VarChar(100)
  tempat_lahir      String?       @db.VarChar(50)
  tanggal_lahir     DateTime?     @db.Date
  program           String?       @db.VarChar(20)
  program_en        String?       @db.VarChar(20)
  gelar             String?       @db.VarChar(100)
  gelar_en          String?       @db.VarChar(100)
  jenis_kelamin     String?       @db.VarChar(20)
  telepon           String?       @db.VarChar(20)
  email             String?       @db.VarChar(100)
  foto              String?
  ipk               Decimal?      @db.Decimal(3, 2)
  predikat          String?       @db.VarChar(50)
  judul_skripsi     String?
  tahun_masuk       Int?
  tahun_lulus       Int?
  status_kelulusan  String?       @db.VarChar(50)
  tanggal_kelulusan DateTime?     @db.Date
  created_at        DateTime?     @default(now()) @db.Timestamp(6)
  dokumen           dokumen[]
  batch_upload      batch_upload? @relation(fields: [id_batch_upload], references: [id_batch_upload], onDelete: Cascade, onUpdate: NoAction)
  prodi             prodi?        @relation(fields: [id_prodi], references: [id_prodi], onDelete: NoAction, onUpdate: NoAction)
  nilai             nilai[]
  validasi          validasi[]
}

model nilai {
  id_nilai     Int        @id @default(autoincrement())
  uuid         String?    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_mahasiswa Int?
  id_akademik  Int?
  nilai_huruf  String?    @db.VarChar(5)
  nilai_angka  Decimal?   @db.Decimal(3, 2)
  created_at   DateTime?  @default(now()) @db.Timestamp(6)
  updated_at   DateTime?  @default(now()) @db.Timestamp(6)
  akademik     akademik?  @relation(fields: [id_akademik], references: [id_akademik], onDelete: Cascade, onUpdate: NoAction)
  mahasiswa    mahasiswa? @relation(fields: [id_mahasiswa], references: [id_mahasiswa], onDelete: Cascade, onUpdate: NoAction)

  @@unique([id_mahasiswa, id_akademik], map: "uq_nilai_mhs_matkul")
}

model template {
  id_template        Int                 @id @default(autoincrement())
  uuid               String?             @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jenis_template     jenis_template_enum
  file_template      String?
  konfigurasi_layout Json?
  created_by         Int?
  created_at         DateTime?           @default(now()) @db.Timestamp(6)
  updated_at         DateTime?           @default(now()) @db.Timestamp(6)
  batch_upload       batch_upload[]
  dokumen            dokumen[]
  users              users?              @relation(fields: [created_by], references: [id_user], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model unit {
  id_unit                  Int             @id @default(autoincrement())
  uuid                     String?         @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parent_id                Int?
  jenis_unit               jenis_unit_enum
  nama_unit                String          @db.VarChar(100)
  nama_unit_en             String?         @db.VarChar(100)
  akreditasi_aipt          String?         @db.VarChar(50)
  rektor                   String?         @db.VarChar(100)
  nidn_rektor              String?         @db.VarChar(50)
  wakil_rektor_1           String?         @db.VarChar(100)
  nidn_wakil_rektor_1      String?         @db.VarChar(50)
  tu_rektorat              String?         @db.VarChar(100)
  file_ttd_rektor          String?
  file_paraf_warek         String?
  file_paraf_tu_rektorat   String?
  file_stempel_universitas String?
  dekan                    String?         @db.VarChar(100)
  nidn_dekan               String?         @db.VarChar(50)
  wakil_dekan_1            String?         @db.VarChar(100)
  nidn_wakil_dekan_1       String?         @db.VarChar(50)
  tu_fakultas              String?         @db.VarChar(100)
  file_ttd_dekan           String?
  file_paraf_wadek         String?
  file_paraf_tu_fakultas   String?
  file_stempel_fakultas    String?
  created_at               DateTime?       @default(now()) @db.Timestamp(6)
  updated_at               DateTime?       @default(now()) @db.Timestamp(6)
  prodi                    prodi[]
  unit                     unit?           @relation("unitTounit", fields: [parent_id], references: [id_unit], onDelete: NoAction, onUpdate: NoAction)
  other_unit               unit[]          @relation("unitTounit")
  users                    users[]
}

model users {
  id_user       Int             @id @default(autoincrement())
  uuid          String?         @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_unit       Int?
  email         String          @unique @db.VarChar(100)
  password      String
  role          String?         @db.VarChar(20)
  is_active     Boolean?        @default(true)
  last_login    DateTime?       @db.Timestamp(6)
  created_at    DateTime?       @default(now()) @db.Timestamp(6)
  updated_at    DateTime?       @default(now()) @db.Timestamp(6)
  batch_upload  batch_upload[]
  log_aktivitas log_aktivitas[]
  template      template[]
  unit          unit?           @relation(fields: [id_unit], references: [id_unit], onDelete: NoAction, onUpdate: NoAction)
  validasi      validasi[]
  refresh_token String?         @db.Text // Tambahkan kolom ini
}

model validasi {
  id_validasi     Int        @id @default(autoincrement())
  uuid            String?    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_mahasiswa    Int?
  validated_by    Int?
  status_validasi String?    @db.VarChar(20)
  level_validasi  Int
  catatan         String?
  validated_at    DateTime?  @db.Timestamp(6)
  created_at      DateTime?  @default(now()) @db.Timestamp(6)
  updated_at      DateTime?  @default(now()) @db.Timestamp(6)
  mahasiswa       mahasiswa? @relation(fields: [id_mahasiswa], references: [id_mahasiswa], onDelete: Cascade, onUpdate: NoAction)
  users           users?     @relation(fields: [validated_by], references: [id_user], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id_mahasiswa, level_validasi], map: "uq_validasi_mahasiswa_level")
}

model prodi {
  id_prodi           Int         @id @default(autoincrement())
  uuid               String?     @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_unit            Int?
  nama_prodi         String      @db.VarChar(100)
  nama_prodi_en      String?     @db.VarChar(100)
  kaprodi            String?     @db.VarChar(100)
  nidn_kaprodi       String?     @db.VarChar(30)
  file_paraf_kaprodi String?
  no_sk_akreditasi   String?     @db.VarChar(50)
  created_at         DateTime?   @default(now()) @db.Timestamp(6)
  updated_at         DateTime?   @default(now()) @db.Timestamp(6)
  akademik           akademik[]
  mahasiswa          mahasiswa[]
  unit               unit?       @relation(fields: [id_unit], references: [id_unit], onDelete: Cascade, onUpdate: NoAction)
}

enum periode_enum {
  semester_ganjil @map("semester ganjil")
  semester_genap  @map("semester genap")
}

enum jenis_dokumen_enum {
  ijazah
  transkrip
}

enum jenis_template_enum {
  ijazah
  transkrip
}

enum jenis_unit_enum {
  universitas
  fakultas
}
