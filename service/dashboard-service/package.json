{
  "name": "dashboard-service",
  "version": "1.0.0",
  "description": "Dashboard Service for UIKA Blockchain Ijazah & Transkrip Digital System - Real-time statistics, monitoring, and analytics for academic document issuance workflow with Neon PostgreSQL",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "rebuild": "npm run clean && npm run build",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "prisma:push": "prisma db push",
    "prisma:pull": "prisma db pull",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "docker:build": "docker build -t dashboard-service:latest .",
    "docker:run": "docker run -p 3005:3005 --env-file .env dashboard-service:latest",
    "db:test": "prisma db push --force-reset && ts-node prisma/seed.ts",
    "db:seed": "ts-node prisma/seed.ts",
    "health": "node -e \"require('http').get('http://localhost:3005/health', (r) => {console.log('Health Check:', r.statusCode)})\"",
    "prisma:migrate": "prisma migrate dev",
    "prisma:reset": "prisma migrate reset",
    "prisma:deploy": "prisma migrate deploy",
    "db:pool": "node -e \"console.log('DB Pool config:', {min: process.env.DB_POOL_MIN, max: process.env.DB_POOL_MAX, idle: process.env.DB_IDLE_TIMEOUT, timeout: process.env.DB_CONNECTION_TIMEOUT})\"",
    "prisma:generate:watch": "nodemon --watch prisma/schema.prisma --exec npm run prisma:generate"
  },
  "keywords": [
    "dashboard",
    "blockchain",
    "ijazah",
    "transkrip",
    "microservices",
    "express",
    "typescript",
    "prisma",
    "postgresql",
    "neon",
    "university",
    "academic",
    "diploma",
    "certificate",
    "uika-bogor"
  ],
  "author": {
    "name": "UIKA Bogor IT Development",
    "email": "it@uika-bogor.ac.id",
    "url": "https://uika-bogor.ac.id"
  },
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/extension-accelerate": "^3.0.1",
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "date-fns": "^3.3.1",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "pg": "^8.20.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.19.39",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.2.5",
    "prisma": "^7.8.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/uika-bogor/blockchain-ijazah/dashboard-service"
  },
  "bugs": {
    "url": "https://github.com/uika-bogor/blockchain-ijazah/issues"
  },
  "homepage": "https://github.com/uika-bogor/blockchain-ijazah/tree/main/dashboard-service#readme"
}
